NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key is server-only; legacy SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=
# Server-only email second-factor delivery (Resend). The sender must be verified with Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Set the canonical URL before production so metadata, robots, and sitemap use your domain.
NEXT_PUBLIC_SITE_URL=
# Financial execution switches default to OFF. Local values are not a substitute for
# the database-controlled production feature flags.
SCHOOLPAY_ENABLED=false
APPLICATIONS_ENABLED=false
IDENTITY_VERIFICATION_ENABLED=false
UNDERWRITING_ENABLED=false
OFFERS_ENABLED=false
AGREEMENTS_ENABLED=false
DISBURSEMENT_ENABLED=false
REPAYMENTS_ENABLED=false
REFUNDS_ENABLED=false
